<?xml version="1.0" encoding="utf-8"?>
<!--
  The foreground watcher exists for one event type: which window took focus. Nothing is read from the
  node tree, so `activityInformation` is deliberately not requested and no content is retrieved —
  the service only answers "who is on top" so the centre card can switch within a frame or two.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds"
    android:canRetrieveWindowContent="false"
    android:description="@string/perm_accessibility_detail"
    android:notificationTimeout="120"
    android:packageNames="@null" />

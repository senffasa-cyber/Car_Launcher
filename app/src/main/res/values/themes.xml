<?xml version="1.0" encoding="utf-8"?>
<!--
  Three themes, all deliberately windowBackground-driven:

  * Theme.CarLauncher — the home screen. No ActionBar, no title, no window animation, opaque dark
    background so the first frame is never white.
  * Theme.CarLauncher.Settings / .Onboarding — the same look without the fullscreen flags, so the
    status bar and IME behave while text is being typed.

  Day/night is NOT expressed here: see theme/Palette.kt, which recomputes every colour in code so the
  switch is instant instead of a configuration change. The windowBackground below is only the seed.
-->
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.CarLauncher" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/car_bg</item>
        <item name="android:colorBackground">@color/car_bg</item>
        <item name="colorBackgroundFloating">@color/car_surface</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowDisablePreview">false</item>
        <item name="android:windowContentTransitions">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:hardwareAccelerated">true</item>
        <item name="android:textColorPrimary">@color/car_text</item>
        <item name="android:textColorSecondary">@color/car_text_muted</item>
        <item name="colorAccent">@color/car_accent</item>
    </style>

    <style name="Theme.CarLauncher.Settings" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/car_bg</item>
        <item name="android:colorBackground">@color/car_bg</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:textColorPrimary">@color/car_text</item>
        <item name="android:textColorSecondary">@color/car_text_muted</item>
        <item name="colorAccent">@color/car_accent</item>
        <item name="android:editTextColor">@color/car_text</item>
        <item name="android:textColorHint">@color/car_text_muted</item>
        <item name="android:colorControlActivated">@color/car_accent</item>
    </style>

    <style name="Theme.CarLauncher.Onboarding" parent="Theme.CarLauncher.Settings">
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>

    <!-- Used by the call overlay's inflated views; kept tiny on purpose (the overlay builds in code). -->
    <style name="Theme.CarLauncher.Overlay" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
